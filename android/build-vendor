#!/usr/bin/env python3
"""Build the iBoot Droid vendor layer component (keyed, deterministic).

Output is a single tar.gz of android/vendor: fixed mtimes, uid/gid 0,
sorted entries. Run by tools/build.py as a component; also runnable by hand
for a quick inspect: android/build-vendor --output PATH.
"""
import argparse
import gzip
import os
import sys
import tarfile
from pathlib import Path

VENDOR = Path(__file__).resolve().parent / 'vendor'


def entries(files):
    relative = []
    for directory, dirs, names in os.walk(VENDOR):
        dirs[:] = sorted(d for d in dirs if d not in ('.git', '__pycache__'))
        for name in sorted(names):
            path = Path(directory) / name
            relative.append((path.relative_to(VENDOR).as_posix(), path))
    return sorted(relative)


def produce(output):
    with gzip.GzipFile(filename='', fileobj=output, mode='wb', compresslevel=9, mtime=0) as gz:
        with tarfile.open(fileobj=gz, mode='w', format=tarfile.PAX_FORMAT) as tar:
            for name, path in entries(VENDOR):
                info = tar.gettarinfo(str(path), arcname=name)
                info.uid = info.gid = 0
                info.uname = info.gname = ''
                info.mtime = 0
                info.pax_headers = {}
                if path.is_file():
                    with path.open('rb') as stream:
                        tar.addfile(info, stream)
                else:
                    tar.addfile(info)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, required=True, help='path of the tar.gz artifact to write')
    args = parser.parse_args()
    if not VENDOR.is_dir() or not any(VENDOR.iterdir()):
        sys.exit(f'{VENDOR}: the vendor layer has no files')
    args.output.parent.mkdir(parents=True, exist_ok=True)
    with args.output.open('wb') as stream:
        produce(stream)


if __name__ == '__main__':
    main()
